# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Safe to expose client-side: restricted by RLS policies, not a secret by itself.
# NEVER expose this one client-side (no NEXT_PUBLIC_ prefix) — bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouteService — openrouteservice.org/dev/#/signup (email only, no card). Dashboard > API key.
# Server-only on purpose (no NEXT_PUBLIC_ prefix) — this key is not designed to be exposed client-side.
ORS_API_KEY=

# Optional — a trip that anyone can open without an account, linked from the landing page as
# "See an Example Trip". Create a trip, then use its id and its share_token (trips table). Both are
# deliberately public (NEXT_PUBLIC_) because the token ends up in the link; use a throwaway trip,
# never a real one. Leave both empty to hide the button.
NEXT_PUBLIC_DEMO_TRIP_ID=
NEXT_PUBLIC_DEMO_TRIP_TOKEN=
